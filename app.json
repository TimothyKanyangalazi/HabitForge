{
  "expo": {
    "name": "HabitForge",
    "slug": "HabitForge",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/HF2.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "scheme": "habitforge",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.starhasty.habitforge"
    },
    "web": {
      "favicon": "./assets/HF2.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      "expo-status-bar",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b929658a-0475-4591-82f7-27fec7dc34df"
      }
    }
  }
}
