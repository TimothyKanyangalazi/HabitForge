{
  "expo": {
    "name": "HabitForge",
    "slug": "HabitForge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/HF3.png",
    "userInterfaceStyle": "automatic",
    "scheme": "habitforge",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/HF3.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "NOTIFICATIONS",
        "VIBRATE"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "com.starhasty.habitforge"
    },
    "web": {
      "favicon": "./assets/HF3.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "b929658a-0475-4591-82f7-27fec7dc34df"
      }
    }
  }
}